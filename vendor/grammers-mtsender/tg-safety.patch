+
+fn forward_update(
+    updates: &mpsc::Sender<UpdatesLike>,
+    loss: &watch::Sender<bool>,
+    update: UpdatesLike,
+) -> Result<(), ForwardError> {
+    let error = match updates.try_send(update) {
+        Ok(()) => return Ok(()),
+        Err(mpsc::error::TrySendError::Full(_)) => ForwardError::Full,
+        Err(mpsc::error::TrySendError::Closed(_)) => ForwardError::Closed,
+    };
+    loss.send_if_modified(|lost| {
+        let changed = !*lost;
+        *lost = true;
+        changed
+    });
+    Err(error)
