+    /// Limits all incoming RPC/control bodies, cumulative gzip output per
+    /// transport payload and recursive envelope processing. A zero limit rejects
+    /// the corresponding input. Cryptographic processing is unchanged.
+    pub fn set_incoming_limits(
+        &mut self,
+        response_bytes: usize,
+        expanded_bytes: usize,
+        nesting: usize,
+    ) {
+        self.rpc_response_limit = response_bytes;
+        self.expansion_limit = expanded_bytes;
+        self.nesting_limit = nesting.min(128);
+    }
+
+    fn inflate(
+        &mut self,
+        packed: &manual_tl::GzipPacked,
+        limit: usize,
+    ) -> Result<Vec<u8>, DeserializeError> {
+        let remaining = self
+            .expansion_limit
+            .saturating_sub(self.expansion_used)
+            .min(limit);
+        if remaining == 0 {
+            return Err(DeserializeError::LimitExceeded);
+        }
+        let result = match packed.decompress_limited(remaining) {
+            Ok(result) => result,
+            Err(error) => {
+                // A failed decoder may already have produced up to the remaining
+                // allowance. Do not give the next result a fresh expansion budget.
+                self.expansion_used = self.expansion_limit;
+                return Err(error);
+            }
+        };
+        self.expansion_used = self
+            .expansion_used
+            .checked_add(result.len())
+            .ok_or(DeserializeError::LimitExceeded)?;
+        Ok(result)
+    }
